{
  "info": {
    "name": "FleetCore API",
    "description": "Colección de FleetCore. Ejecuta primero \"Auth > Login ADMIN\" y \"Auth > Login TECHNICIAN\": guardan los tokens en adminToken y techToken. Los ids corresponden a los datos del seeder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fleetcore.com\",\n  \"password\": \"Admin123*\"\n}"
            },
            "description": "Guarda el token en la variable adminToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('adminToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login TECHNICIAN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tecnico1@fleetcore.com\",\n  \"password\": \"Tecnico123*\"\n}"
            },
            "description": "Guarda el token en la variable techToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('techToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar TECHNICIAN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Ruiz\",\n  \"email\": \"ana@fleetcore.com\",\n  \"password\": \"Tecnico123*\"\n}"
            }
          }
        },
        {
          "name": "Registrar ADMIN (requiere Bearer ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro Admin\",\n  \"email\": \"admin2@fleetcore.com\",\n  \"password\": \"Admin123*\",\n  \"role\": \"ADMIN\"\n}"
            }
          }
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
