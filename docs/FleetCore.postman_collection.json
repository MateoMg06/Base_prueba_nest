                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Login con GitHub (abrir en navegador)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/github",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "github"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Redirige a GitHub. Ábrelo en el navegador: al autorizar, /auth/github/callback devuelve el JWT."
          }
        }
      ]
    },
