# ───────────── App ─────────────
NODE_ENV=development
PORT=3000
SWAGGER_PATH=docs

# ───────────── Seguridad ─────────────
# Firma de los JWT: cadena aleatoria de 32+ caracteres (genera una con
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia-esta-clave-ficticia-de-desarrollo-32+
# Validez del token en segundos
JWT_EXPIRES_IN=3600

# API Keys para integraciones externas (x-api-key)
# Varias API Keys válidas separadas por comas (claves FICTICIAS, no usar en producción)
API_KEYS=dev-key-123,qa-key-456

# ───────────── Base de datos ─────────────
# Valores de desarrollo compatibles con docker compose up -d db.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=fleetcore
DB_USERNAME=fleetcore
DB_PASSWORD=fleetcore_dev_password
# true crea/actualiza tablas automáticamente (solo desarrollo / prueba)
DB_SYNCHRONIZE=true
DB_LOGGING=false
