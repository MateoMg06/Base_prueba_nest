# ───────────── App ─────────────
NODE_ENV=development
PORT=3000
SWAGGER_PATH=docs

# ───────────── Seguridad ─────────────
# Varias API Keys válidas separadas por comas (claves FICTICIAS, no usar en producción)
API_KEYS=dev-key-123,qa-key-456

# ───────────── Base de datos ─────────────
# better-sqlite3 (por defecto) | postgres | mysql
DB_TYPE=better-sqlite3
# SQLite: ruta del archivo (o :memory:). Postgres/MySQL: nombre de la base
DB_DATABASE=data/database.sqlite
# Solo para postgres/mysql
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
# true crea/actualiza tablas automáticamente (solo desarrollo / prueba)
DB_SYNCHRONIZE=true
DB_LOGGING=false
